NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgres://fiyah:fiyah@localhost:5432/fiyah
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=replace-with-64-hex-characters

# Seed administrator accounts (development only)
SEED_ADMIN_ONE_EMAIL=admin1@fiyah.local
SEED_ADMIN_ONE_PASSWORD=ChangeMe123!
SEED_ADMIN_TWO_EMAIL=admin2@fiyah.local
SEED_ADMIN_TWO_PASSWORD=ChangeMe456!

# WhatsApp Cloud API. Leave blank to use the local simulator.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# Protects the optional /internal/jobs/reconcile endpoint.
CRON_SECRET=replace-with-at-least-16-random-characters

# MTN Cameroon Collections sandbox. Leave blank to use the local simulator.
MTN_COLLECTION_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=sandbox
# MTN's shared sandbox accepts EUR only. Keep XAF for production environments.
MTN_SANDBOX_COLLECTION_CURRENCY=EUR
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_CALLBACK_URL=http://localhost:4000/webhooks/mtn

# FIYAH business rules
FIYAH_SERVICE_FEE_BPS=150
FIYAH_MIN_TRANSFER_XAF=10000
FIYAH_MAX_TRANSFER_XAF=1000000
FIYAH_DAILY_TRANSFER_LIMIT=5
FIYAH_QUOTE_TTL_MINUTES=10
FIYAH_PAYOUT_SLA_MINUTES=15
FIYAH_REFUND_SLA_MINUTES=60
